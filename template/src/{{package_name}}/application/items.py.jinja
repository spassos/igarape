"""Item use cases."""

import json
from datetime import datetime
from uuid import UUID

from {{ package_name }}.application.ports import Cache, EventPublisher, ItemRepository
from {{ package_name }}.domain.errors import ItemNotFoundError
from {{ package_name }}.domain.items import Item, ItemCreated


class ItemService:
    """Create and read items (cache-aside on reads, event on writes).

    Every operation is scoped to an owner: callers pass the authenticated subject, never an id
    taken from the request body (object-level authorization, OWASP API1).
    """

    def __init__(
        self,
        repository: ItemRepository,
        cache: Cache,
        publisher: EventPublisher,
        cache_ttl_seconds: int = 300,
    ) -> None:
        self._repository = repository
        self._cache = cache
        self._publisher = publisher
        self._cache_ttl_seconds = cache_ttl_seconds

    async def create(self, name: str, *, owner_id: str) -> Item:
        """Persist a new item owned by ``owner_id`` and announce it."""
        item = Item(name=name, owner_id=owner_id)
        await self._repository.add(item)
        event = ItemCreated.from_item(item)
        await self._publisher.publish(event.topic, event.payload())
        return item

    async def get(self, item_id: UUID, *, owner_id: str) -> Item:
        """Return an item owned by ``owner_id``, serving from cache when possible.

        Items owned by someone else are reported as not found, so ids cannot be probed.
        """
        key = f"items:{item_id}"
        if cached := await self._cache.get(key):
            item = _decode(cached)
        else:
            found = await self._repository.get(item_id)
            if found is None:
                raise ItemNotFoundError(item_id)
            item = found
            await self._cache.set(key, _encode(item), self._cache_ttl_seconds)
        if item.owner_id != owner_id:
            raise ItemNotFoundError(item_id)
        return item


def _encode(item: Item) -> str:
    return json.dumps(
        {
            "id": str(item.id),
            "name": item.name,
            "owner_id": item.owner_id,
            "created_at": item.created_at.isoformat(),
        }
    )


def _decode(raw: str) -> Item:
    data = json.loads(raw)
    return Item(
        id=UUID(data["id"]),
        name=data["name"],
        owner_id=data["owner_id"],
        created_at=datetime.fromisoformat(data["created_at"]),
    )
