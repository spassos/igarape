from {{ package_name }}.config import Settings


@dataclass(frozen=True, slots=True)
class Container:
    """Application services plus readiness checks for their dependencies."""

    items: ItemService
    health_checks: Mapping[str, HealthCheck]
    token_verifier: TokenVerifier


ContainerFactory = Callable[[Settings], AbstractAsyncContextManager[Container]]


def build_token_verifier(settings: Settings) -> TokenVerifier:
    """JWKS in every environment; the HS256 dev secret only in local/test (see Settings)."""
    if settings.auth_jwks_url and settings.auth_issuer and settings.auth_audience:
        return JwtTokenVerifier.from_jwks(
            settings.auth_jwks_url,
            issuer=settings.auth_issuer,
            audience=settings.auth_audience,
            algorithms=settings.auth_algorithms,
            scopes_claim=settings.auth_scopes_claim,
        )
    if (
        settings.auth_dev_secret
        and settings.env in {"local", "test"}
        and settings.auth_issuer
        and settings.auth_audience
    ):
        return JwtTokenVerifier.from_shared_secret(
            settings.auth_dev_secret.get_secret_value(),
            issuer=settings.auth_issuer,
            audience=settings.auth_audience,
            scopes_claim=settings.auth_scopes_claim,
        )
    return DenyAllTokenVerifier()


@asynccontextmanager
{%- if event_broker != 'none' %}
async def build_container(
    settings: Settings, broker: broker_adapter.Broker | None = None
) -> AsyncIterator[Container]:
{%- else %}
async def build_container(settings: Settings) -> AsyncIterator[Container]:
{%- endif %}
    """Wire adapters from settings and release them on exit."""
    checks: dict[str, HealthCheck] = {}
    async with AsyncExitStack(){% if use_postgres or use_redis or event_broker != 'none' %} as stack{% endif %}:
{%- if use_postgres %}
        engine = postgres.create_engine(settings.database_url.get_secret_value())
        stack.push_async_callback(engine.dispose)
        repository = postgres.PostgresItemRepository(engine)
        checks["postgres"] = partial(postgres.ping, engine)
{%- else %}
        repository = memory.InMemoryItemRepository()
{%- endif %}
{%- if use_redis %}
        redis = redis_cache.create_redis(settings.redis_url.get_secret_value())
        stack.push_async_callback(redis.aclose)
        cache = redis_cache.RedisCache(redis)
        checks["redis"] = partial(redis_cache.ping, redis)
{%- else %}
        cache = memory.InMemoryCache()
{%- endif %}
{%- if event_broker != 'none' %}
        if broker is None:
            broker = broker_adapter.create_broker(settings.broker_url.get_secret_value())
            await broker.connect()
            stack.push_async_callback(broker.stop)
        publisher = broker_adapter.BrokerEventPublisher(broker)
        checks["broker"] = partial(broker_adapter.ping, broker)
{%- else %}
        publisher = memory.InMemoryEventPublisher()
{%- endif %}
        yield Container(
            items=ItemService(repository, cache, publisher, settings.cache_ttl_seconds),
            health_checks=checks,
            token_verifier=build_token_verifier(settings),
        )
