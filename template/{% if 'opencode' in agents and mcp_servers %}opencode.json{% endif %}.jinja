{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
{%- for name, url in mcp_servers.items() %}
      {{ name | to_json(ensure_ascii=False) }}: {
        "type": "remote",
        "url": {{ url | to_json(ensure_ascii=False) }}
      }{% if not loop.last %},{% endif %}
{%- endfor %}
    }
  }
}
