{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test-unit)",
      "Bash(make check)",
      "Bash(make fmt)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make arch)",
      "Bash(make audit)",
      "Bash(uv run pytest *)",
      "Bash(git *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  }
}
