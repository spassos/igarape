{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test-unit)",
      "Bash(make check)",
      "Bash(make fmt)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make arch)",
      "Bash(make audit)",
      "Bash(uv run pytest *)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --cached)",
      "Bash(git diff --stat)",
      "Bash(git log --oneline)",
      "Bash(git add -- *)",
      "Bash(git commit -m *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  }
}
