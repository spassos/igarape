"""Alembic environment (async). URL and metadata come from the application."""

import asyncio

from alembic import context
from sqlalchemy.engine import Connection

from {{ package_name }}.adapters.postgres import create_engine, metadata
from {{ package_name }}.config import Settings


def _url() -> str:
    return context.config.get_main_option("sqlalchemy.url") or (
        Settings().database_url.get_secret_value()
    )


def _run(connection: Connection) -> None:
    context.configure(connection=connection, target_metadata=metadata)
    with context.begin_transaction():
        context.run_migrations()


async def _run_online() -> None:
    engine = create_engine(_url())
    async with engine.connect() as connection:
        await connection.run_sync(_run)
    await engine.dispose()


if context.is_offline_mode():
    context.configure(url=_url(), target_metadata=metadata, literal_binds=True)
    with context.begin_transaction():
        context.run_migrations()
else:
    asyncio.run(_run_online())
