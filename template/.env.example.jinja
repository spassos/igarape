# `make bootstrap` copies this file to .env and appends APP_AUTH_DEV_SECRET (never commit .env).
# All settings: src/{{ package_name }}/config.py
APP_ENV=local
APP_LOG_LEVEL=DEBUG
# Auth (local/test only): APP_AUTH_DEV_SECRET signs `make token` tokens (32+ characters).
# Staging/production: your OIDC provider (APP_AUTH_DEV_SECRET must stay unset there).
# APP_AUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# APP_AUTH_ISSUER=https://idp.example.com/
# APP_AUTH_AUDIENCE={{ project_slug }}
{%- if use_postgres or use_redis or event_broker != 'none' %}
# Services started by `make dev` in Docker. Using your own? Change the URLs and run `make dev DOCKER=0`.
{%- endif %}
{%- if use_postgres %}
APP_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
{%- endif %}
{%- if use_redis %}
APP_REDIS_URL=redis://localhost:6379/0
{%- endif %}
{%- if event_broker == 'kafka' %}
APP_BROKER_URL=localhost:9092
{%- elif event_broker == 'rabbit' %}
APP_BROKER_URL=amqp://guest:guest@localhost:5672/
{%- endif %}
