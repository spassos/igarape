# Copy to .env for `make run` (never commit .env). All settings: src/{{ package_name }}/config.py
APP_ENV=local
APP_LOG_LEVEL=DEBUG
# Auth (local/test only): HS256 secret for `make token`. Generate one with `openssl rand -hex 32`.
# APP_AUTH_DEV_SECRET=
# Staging/production: your OIDC provider (APP_AUTH_DEV_SECRET must stay unset there).
# APP_AUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# APP_AUTH_ISSUER=https://idp.example.com/
# APP_AUTH_AUDIENCE={{ project_slug }}
{%- if use_postgres %}
APP_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
{%- endif %}
{%- if use_redis %}
APP_REDIS_URL=redis://localhost:6379/0
{%- endif %}
{%- if event_broker == 'kafka' %}
APP_BROKER_URL=localhost:9092
{%- elif event_broker == 'rabbit' %}
APP_BROKER_URL=amqp://guest:guest@localhost:5672/
{%- endif %}
