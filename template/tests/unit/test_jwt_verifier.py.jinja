from datetime import UTC, datetime, timedelta
from typing import Any

import httpx
import jwt
import pytest
import respx

from {{ package_name }}.adapters.jwt_verifier import (
    DenyAllTokenVerifier,
    HttpxJWKClient,
    JwtTokenVerifier,
    parse_scopes,
)
from {{ package_name }}.config import Settings
from {{ package_name }}.container import build_token_verifier
from {{ package_name }}.domain.errors import AuthenticationError
from {{ package_name }}.domain.security import Principal
from tests.tokens import (
    AUDIENCE,
    AUTH_SECRET,
    ISSUER,
    JWKS_URL,
    claims,
    jwks,
    rsa_key,
    sign_rs256,
)

pytestmark = pytest.mark.anyio


def jwks_verifier(**options: Any) -> JwtTokenVerifier:
    return JwtTokenVerifier.from_jwks(
        JWKS_URL, issuer=ISSUER, audience=AUDIENCE, algorithms=["RS256"], **options
    )


def idp_claims(**overrides: Any) -> dict[str, Any]:
    return claims(issuer=ISSUER, audience=AUDIENCE, **overrides)


@respx.mock
async def test_jwks_token_yields_principal() -> None:
    respx.get(JWKS_URL).mock(return_value=httpx.Response(200, json=jwks("key-1")))

    principal = await jwks_verifier().verify(sign_rs256(idp_claims(subject="alice")))

    assert principal == Principal(subject="alice", scopes=frozenset({"items:read", "items:write"}))


@respx.mock
async def test_jwks_is_cached_between_verifications() -> None:
    route = respx.get(JWKS_URL).mock(return_value=httpx.Response(200, json=jwks("key-1")))
    verifier = jwks_verifier()

    for _ in range(3):
        await verifier.verify(sign_rs256(idp_claims()))

    assert route.call_count == 1


@respx.mock
async def test_rotated_key_is_fetched_on_unknown_kid() -> None:
    route = respx.get(JWKS_URL).mock(
        side_effect=[
            httpx.Response(200, json=jwks("key-1")),
            httpx.Response(200, json=jwks("key-1", "key-2")),
        ]
    )
    verifier = jwks_verifier(refresh_cooldown_seconds=0)
    await verifier.verify(sign_rs256(idp_claims(), kid="key-1"))

    principal = await verifier.verify(sign_rs256(idp_claims(subject="bob"), kid="key-2"))

    assert principal.subject == "bob"
    assert route.call_count == 2


@respx.mock
async def test_forged_kids_cannot_force_a_refetch_storm() -> None:
    route = respx.get(JWKS_URL).mock(return_value=httpx.Response(200, json=jwks("key-1")))
    verifier = jwks_verifier()

    for index in range(5):
        with pytest.raises(AuthenticationError):
            await verifier.verify(sign_rs256(idp_claims(), kid=f"forged-{index}"))

    assert route.call_count <= 2


@respx.mock
async def test_token_without_kid_is_rejected_before_any_fetch() -> None:
    route = respx.get(JWKS_URL).mock(return_value=httpx.Response(200, json=jwks("key-1")))
    token = jwt.encode(idp_claims(), rsa_key("key-1"), algorithm="RS256")

    with pytest.raises(AuthenticationError):
        await jwks_verifier().verify(token)
    assert not route.called


@respx.mock
@pytest.mark.parametrize("response", [httpx.Response(503), httpx.Response(200, text="<html>")])
async def test_unavailable_jwks_rejects_tokens(response: httpx.Response) -> None:
    respx.get(JWKS_URL).mock(return_value=response)

    with pytest.raises(AuthenticationError):
        await jwks_verifier().verify(sign_rs256(idp_claims()))


def test_jwk_client_fetches_without_following_redirects() -> None:
    with respx.mock:
        respx.get(JWKS_URL).mock(
            return_value=httpx.Response(302, headers={"Location": "http://169.254.169.254/"})
        )
        with pytest.raises(jwt.PyJWKClientConnectionError, match="JWKS"):
            HttpxJWKClient(JWKS_URL).fetch_data()


async def test_shared_secret_verifier_accepts_dev_tokens() -> None:
    verifier = JwtTokenVerifier.from_shared_secret(AUTH_SECRET, issuer=ISSUER, audience=AUDIENCE)
    token = jwt.encode(idp_claims(subject="carol"), AUTH_SECRET, algorithm="HS256")

    assert (await verifier.verify(token)).subject == "carol"


async def test_rs256_token_is_rejected_by_shared_secret_verifier() -> None:
    verifier = JwtTokenVerifier.from_shared_secret(AUTH_SECRET, issuer=ISSUER, audience=AUDIENCE)

    with pytest.raises(AuthenticationError):
        await verifier.verify(sign_rs256(idp_claims()))


@pytest.mark.parametrize(
    ("token_claims", "claim", "expected"),
    [
        ({"scope": "a b"}, "scope", {"a", "b"}),
        ({"scp": ["a", "b"]}, "scope", {"a", "b"}),
        ({"scp": "a b"}, "scope", {"a", "b"}),
        ({"scope": "a", "scp": ["b"]}, "scope", {"a"}),
        ({"permissions": ["items:read"]}, "permissions", {"items:read"}),
        ({"scope": "a"}, "permissions", set()),
        ({}, "scope", set()),
    ],
)
def test_scopes_are_parsed_from_the_configured_claim(
    token_claims: dict[str, Any], claim: str, expected: set[str]
) -> None:
    assert parse_scopes(token_claims, claim) == expected


@pytest.mark.parametrize("raw", [["a", 1], {"a": True}, 42])
def test_malformed_scope_claim_is_rejected(raw: object) -> None:
    with pytest.raises(AuthenticationError):
        parse_scopes({"scope": raw})


@respx.mock
async def test_custom_scope_claim_is_honoured() -> None:
    respx.get(JWKS_URL).mock(return_value=httpx.Response(200, json=jwks("key-1")))
    token = sign_rs256(idp_claims(scope=None, permissions=["items:read"]))

    principal = await jwks_verifier(scopes_claim="permissions").verify(token)

    assert principal.scopes == {"items:read"}


@respx.mock
async def test_not_before_is_checked_with_leeway() -> None:
    respx.get(JWKS_URL).mock(return_value=httpx.Response(200, json=jwks("key-1")))
    soon = datetime.now(UTC) + timedelta(seconds=10)
    later = datetime.now(UTC) + timedelta(minutes=2)
    verifier = jwks_verifier()

    assert await verifier.verify(sign_rs256(idp_claims(nbf=soon)))
    with pytest.raises(AuthenticationError):
        await verifier.verify(sign_rs256(idp_claims(nbf=later)))


@pytest.mark.parametrize(
    "options",
    [
        {"algorithms": ["HS256"], "jwks_client": HttpxJWKClient(JWKS_URL)},
        {"algorithms": ["none"], "secret": AUTH_SECRET},
        {"algorithms": ["RS256"]},
        {"algorithms": ["RS256"], "secret": AUTH_SECRET, "jwks_client": HttpxJWKClient(JWKS_URL)},
    ],
)
def test_unsafe_verifier_configuration_is_refused(options: dict[str, Any]) -> None:
    with pytest.raises(ValueError, match=r"exactly one|Algorithm"):
        JwtTokenVerifier(issuer=ISSUER, audience=AUDIENCE, **options)


async def test_deny_all_verifier_rejects_everything() -> None:
    with pytest.raises(AuthenticationError):
        await DenyAllTokenVerifier().verify("anything")


@pytest.mark.parametrize(
    ("settings", "expected"),
    [
        (
            {"auth_jwks_url": JWKS_URL, "auth_issuer": ISSUER, "auth_audience": AUDIENCE},
            JwtTokenVerifier,
        ),
        ({"auth_dev_secret": AUTH_SECRET}, JwtTokenVerifier),
        ({}, DenyAllTokenVerifier),
    ],
)
def test_composition_root_picks_the_verifier(settings: dict[str, str], expected: type) -> None:
    verifier = build_token_verifier(Settings.model_validate({"env": "test"} | settings))

    assert isinstance(verifier, expected)
