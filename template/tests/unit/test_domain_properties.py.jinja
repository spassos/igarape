"""Property-based tests for domain invariants and serialization (Hypothesis).

Test level: unit, pure Python and in-memory adapters; runs in `make test-unit`. Instead of a few
hand-picked examples, each property is checked against generated inputs: valid names are always
accepted, blank or oversized names always rejected, the `items.created` payload survives a JSON
round trip, the cache encoding used by `ItemService` returns the same Item it stored, and an item
is never returned to another owner, whether it is read from the repository or from the cache.

Flakiness control: the `PROPERTIES` settings derandomize generation (the same inputs on every run
and machine), bound the number of examples, disable the deadline and keep no example database.
"""

import asyncio
import json
from datetime import UTC, datetime, timedelta, timezone
from uuid import UUID

import pytest
from hypothesis import assume, given, settings
from hypothesis import strategies as st

from {{ package_name }}.adapters.memory import (
    InMemoryCache,
    InMemoryEventPublisher,
    InMemoryItemRepository,
)
from {{ package_name }}.application.items import ItemService
from {{ package_name }}.domain.errors import InvalidItemError, ItemNotFoundError
from {{ package_name }}.domain.items import (
    NAME_MAX_LENGTH,
    OWNER_ID_MAX_LENGTH,
    Item,
    ItemCreated,
)
from tests.factories import make_item

PROPERTIES = settings(max_examples=100, derandomize=True, deadline=None, database=None)

WHITESPACE = "".join(c for c in map(chr, range(0x3001)) if c.isspace())

valid_names = st.text(min_size=1, max_size=NAME_MAX_LENGTH).filter(str.strip)
blank_names = st.text(alphabet=WHITESPACE, max_size=NAME_MAX_LENGTH)
oversized_names = st.text(min_size=NAME_MAX_LENGTH + 1, max_size=NAME_MAX_LENGTH * 2)
owner_ids = st.text(min_size=1, max_size=OWNER_ID_MAX_LENGTH)
# Real UTC offsets are whole minutes; sub-minute offsets do not survive isoformat on every Python.
offsets = st.integers(min_value=-23 * 60, max_value=23 * 60).map(
    lambda minutes: timezone(timedelta(minutes=minutes))
)
aware_datetimes = st.datetimes(
    min_value=datetime(1970, 1, 1),  # noqa: DTZ001 - bounds are naive by Hypothesis' contract
    max_value=datetime(9998, 12, 31),  # noqa: DTZ001
    timezones=st.just(UTC) | offsets,
)
items = st.builds(
    make_item, name=valid_names, owner_id=owner_ids, id=st.uuids(), created_at=aware_datetimes
)


def in_memory_service() -> tuple[ItemService, InMemoryItemRepository]:
    repository = InMemoryItemRepository()
    return ItemService(repository, InMemoryCache(), InMemoryEventPublisher(), 60), repository


@PROPERTIES
@given(name=valid_names)
def test_valid_names_are_accepted(name: str) -> None:
    assert make_item(name=name).name == name


@PROPERTIES
@given(name=blank_names | oversized_names)
def test_blank_or_oversized_names_are_rejected(name: str) -> None:
    with pytest.raises(InvalidItemError):
        make_item(name=name)


@PROPERTIES
@given(item=items)
def test_event_payload_survives_json_round_trip(item: Item) -> None:
    payload = ItemCreated.from_item(item).payload()

    decoded = json.loads(json.dumps(payload))

    assert decoded == payload
    assert UUID(decoded["item_id"]) == item.id
    assert decoded["name"] == item.name
    assert decoded["owner_id"] == item.owner_id
    assert datetime.fromisoformat(decoded["occurred_at"]) == item.created_at


@PROPERTIES
@given(item=items)
def test_cache_round_trip_returns_the_stored_item(item: Item) -> None:
    service, repository = in_memory_service()

    async def read_twice() -> tuple[Item, Item]:
        await repository.add(item)
        from_repository = await service.get(item.id, owner_id=item.owner_id)
        repository.items.clear()  # the second read can only be served by the cache
        return from_repository, await service.get(item.id, owner_id=item.owner_id)

    from_repository, from_cache = asyncio.run(read_twice())

    assert from_repository == from_cache == item
    assert from_cache.created_at.utcoffset() == item.created_at.utcoffset()


@PROPERTIES
@given(item=items, other=owner_ids, cached=st.booleans())
def test_items_are_hidden_from_other_owners(item: Item, other: str, cached: bool) -> None:
    assume(other != item.owner_id)
    service, repository = in_memory_service()

    async def read_as_other_owner() -> None:
        await repository.add(item)
        if cached:
            await service.get(item.id, owner_id=item.owner_id)
        await service.get(item.id, owner_id=other)

    with pytest.raises(ItemNotFoundError):
        asyncio.run(read_as_other_owner())
