PROBLEM = "application/problem+json"
JWKS_SETTINGS = {
    "auth_dev_secret": None,
    "auth_jwks_url": JWKS_URL,
    "auth_issuer": ISSUER,
    "auth_audience": AUDIENCE,
}


def build_client(service: ItemService, settings: Settings) -> TestClient:
    @asynccontextmanager
    async def in_memory(_: Settings) -> AsyncIterator[Container]:
        yield Container(
            items=service, health_checks={}, token_verifier=build_token_verifier(settings)
        )

    return TestClient(create_app(settings, container_factory=in_memory))


def bearer(token: str) -> dict[str, str]:
    return {"Authorization": f"Bearer {token}"}


def assert_problem(response: httpx.Response, status: int) -> None:
    assert response.status_code == status
    assert response.headers["Content-Type"] == PROBLEM
    body = response.json()
    assert body["status"] == status
    assert {"type", "title", "status", "detail", "instance"} <= body.keys()


# ---------------------------------------------------------------- API2 authentication


def test_missing_token_is_rejected_with_bearer_challenge(client: TestClient) -> None:
    response = client.post("/v1/items", json={"name": "book"})

    assert_problem(response, 401)
    assert response.headers["WWW-Authenticate"].startswith("Bearer")
    assert response.json()["instance"] == "/v1/items"


@pytest.mark.parametrize(
    "authorization",
    [
        "Bearer not-a-jwt",
        "Bearer a.b.c",
        "Basic YWxpY2U6c2VjcmV0",
        f"Bearer {sign_hs256(claims(), secret='0' * 64)}",
        f"Bearer {unsigned(claims())}",
        f"Bearer {sign_hs256(claims(exp=datetime.now(UTC) - timedelta(minutes=2)))}",
        f"Bearer {sign_hs256(claims(nbf=datetime.now(UTC) + timedelta(minutes=2)))}",
        f"Bearer {sign_hs256(claims(issuer='https://evil.example.com/'))}",
        f"Bearer {sign_hs256(claims(audience='another-api'))}",
        f"Bearer {sign_hs256(claims(sub=None))}",
        f"Bearer {sign_hs256(claims(sub=''))}",
        f"Bearer {sign_hs256(claims(exp=None))}",
        f"Bearer {sign_hs256(claims(iss=None))}",
        f"Bearer {sign_hs256(claims(aud=None))}",
    ],
    ids=[
        "malformed",
        "garbage-segments",
        "not-bearer",
        "wrong-secret",
        "alg-none",
        "expired",
        "not-yet-valid",
        "wrong-issuer",
        "wrong-audience",
        "no-subject",
        "empty-subject",
        "no-exp",
        "no-iss",
        "no-aud",
    ],
)
def test_invalid_tokens_are_rejected(client: TestClient, authorization: str) -> None:
    response = client.get(f"/v1/items/{uuid4()}", headers={"Authorization": authorization})

    assert_problem(response, 401)
    assert response.headers["WWW-Authenticate"].startswith("Bearer")


def test_clock_skew_within_leeway_is_tolerated(client: TestClient) -> None:
    token = sign_hs256(claims(exp=datetime.now(UTC) - timedelta(seconds=10)))

    response = client.post("/v1/items", json={"name": "book"}, headers=bearer(token))

    assert response.status_code == 201


def test_every_v1_route_requires_a_token(client: TestClient) -> None:
    paths = client.get("/openapi.json").json()["paths"]
    operations = [
        (method, path) for path, item in paths.items() if path.startswith("/v1/") for method in item
    ]
    assert operations
    for method, path in operations:
        url = re.sub(r"\{[^}]+\}", str(uuid4()), path)

        response = client.request(method, url, json={"name": "book"})

        assert response.status_code == 401, f"{method.upper()} {path}"
        assert paths[path][method]["security"] == [{"HTTPBearer": []}]


@pytest.fixture
def jwks_client(service: ItemService) -> Iterator[TestClient]:
    with respx.mock(assert_all_called=False) as mock:
        mock.get(JWKS_URL).mock(return_value=httpx.Response(200, json=jwks("key-1")))
