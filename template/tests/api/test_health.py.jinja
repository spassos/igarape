from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

import pytest
from fastapi.testclient import TestClient

from {{ package_name }}.application.items import ItemService
from {{ package_name }}.config import Settings
from {{ package_name }}.container import Container
from {{ package_name }}.entrypoints.http.app import create_app


def test_live_reports_version(client: TestClient) -> None:
    response = client.get("/health/live")

    assert response.status_code == 200
    assert response.json()["version"] == "test-sha"


@pytest.mark.parametrize(("healthy", "status"), [(True, 200), (False, 503)])
def test_ready_reflects_dependencies(service: ItemService, healthy: bool, status: int) -> None:
    async def check() -> None:
        if not healthy:
            raise ConnectionError

    @asynccontextmanager
    async def factory(_: Settings) -> AsyncIterator[Container]:
        yield Container(items=service, health_checks={"db": check})

    with TestClient(create_app(Settings(env="test"), container_factory=factory)) as client:
        response = client.get("/health/ready")

    assert response.status_code == status
    assert response.json()["checks"] == {"db": "ok" if healthy else "error"}
