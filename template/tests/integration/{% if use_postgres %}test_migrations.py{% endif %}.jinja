"""Migration tests on a fresh PostgreSQL (testcontainers, needs Docker).

Test level: integration, `make test` / `make check` only. Every revision must upgrade, downgrade
and upgrade again (stairway), the whole chain must round-trip `head -> base -> head`, and the
SQLAlchemy metadata the adapters use must match what the migrations build (`alembic check`:
a model change without its migration fails here, not in production).

Flakiness control: a dedicated container per module, so no state is shared with other tests.
"""

import asyncio
from collections.abc import Iterator
from pathlib import Path

import pytest
from alembic import command
from alembic.config import Config
from alembic.script import ScriptDirectory
from sqlalchemy import inspect
from testcontainers.community.postgres import PostgresContainer

from {{ package_name }}.adapters.postgres import create_engine, metadata

pytestmark = pytest.mark.integration

ROOT = Path(__file__).parents[2]


@pytest.fixture(scope="module")
def alembic_config() -> Iterator[Config]:
    with PostgresContainer("postgres:17-alpine", driver="asyncpg") as postgres:
        config = Config(ROOT / "alembic.ini")
        config.set_main_option("sqlalchemy.url", postgres.get_connection_url())
        yield config


def tables(config: Config) -> set[str]:
    async def read() -> set[str]:
        engine = create_engine(config.get_main_option("sqlalchemy.url") or "")
        async with engine.connect() as conn:
            names = await conn.run_sync(lambda sync: set(inspect(sync).get_table_names()))
        await engine.dispose()
        return names - {"alembic_version"}

    return asyncio.run(read())


def test_each_revision_downgrades_and_upgrades_again(alembic_config: Config) -> None:
    revisions = list(ScriptDirectory.from_config(alembic_config).walk_revisions("base", "heads"))
    for revision in reversed(revisions):
        command.upgrade(alembic_config, revision.revision)
        command.downgrade(alembic_config, "-1")
        command.upgrade(alembic_config, revision.revision)


def test_migrations_round_trip_and_match_the_models(alembic_config: Config) -> None:
    command.upgrade(alembic_config, "head")
    command.downgrade(alembic_config, "base")
    assert tables(alembic_config) == set()

    command.upgrade(alembic_config, "head")

    assert tables(alembic_config) == set(metadata.tables)
    command.check(alembic_config)  # raises AutogenerateDiffsDetected on model/migration drift
