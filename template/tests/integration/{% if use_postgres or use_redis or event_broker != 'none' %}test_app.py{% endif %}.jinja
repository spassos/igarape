"""End-to-end through the real composition root and real infrastructure."""

import pytest
from fastapi.testclient import TestClient

from {{ package_name }}.config import Settings
from {{ package_name }}.entrypoints.http.app import create_app

pytestmark = pytest.mark.integration


def test_item_round_trip_and_readiness(settings: Settings) -> None:
    with TestClient(create_app(settings)) as client:
        created = client.post("/items", json={"name": "book"}).json()
        first = client.get(f"/items/{created['id']}")
        cached = client.get(f"/items/{created['id']}")
        ready = client.get("/health/ready")

    assert first.json() == cached.json() == created
    assert ready.status_code == 200
