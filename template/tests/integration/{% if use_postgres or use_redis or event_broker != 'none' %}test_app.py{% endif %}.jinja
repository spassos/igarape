"""End-to-end through the real composition root and real infrastructure."""

import pytest
from fastapi.testclient import TestClient

from {{ package_name }}.config import Settings
from {{ package_name }}.entrypoints.http.app import create_app
from tests.conftest import MakeAuthHeaders

pytestmark = pytest.mark.integration


def test_item_round_trip_and_readiness(
    settings: Settings, make_auth_headers: MakeAuthHeaders
) -> None:
    alice, bob = make_auth_headers("alice"), make_auth_headers("bob")
    with TestClient(create_app(settings)) as client:
        created = client.post("/v1/items", json={"name": "book"}, headers=alice).json()
        first = client.get(f"/v1/items/{created['id']}", headers=alice)
        cached = client.get(f"/v1/items/{created['id']}", headers=alice)
        foreign = client.get(f"/v1/items/{created['id']}", headers=bob)
        ready = client.get("/health/ready")

    assert first.json() == cached.json() == created
    assert foreign.status_code == 404
    assert ready.status_code == 200
