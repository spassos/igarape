def api_settings(**overrides: object) -> Settings:
    """Test settings whose verifier accepts tokens from ``make_auth_headers``."""
    return Settings.model_validate(
        {"env": "test", "version": "test-sha", "auth_dev_secret": AUTH_SECRET} | overrides
    )


@pytest.fixture
def client(service: ItemService) -> Iterator[TestClient]:
    settings = api_settings()

    @asynccontextmanager
    async def in_memory(_: Settings) -> AsyncIterator[Container]:
        yield Container(
            items=service, health_checks={}, token_verifier=build_token_verifier(settings)
        )

    app = create_app(settings, container_factory=in_memory)
    with TestClient(app) as test_client:
        yield test_client


class MakeAuthHeaders(Protocol):
    def __call__(
        self, subject: str = "alice", scopes: tuple[str, ...] = DEFAULT_SCOPES
    ) -> dict[str, str]: ...


@pytest.fixture
def make_auth_headers() -> MakeAuthHeaders:
    """Bearer headers signed for the real JWT verifier used by ``client``."""

    def make(subject: str = "alice", scopes: tuple[str, ...] = DEFAULT_SCOPES) -> dict[str, str]:
        return {"Authorization": f"Bearer {sign_hs256(claims(subject, scopes))}"}

    return make
