# Single entry point for humans, agents and CI. `make help` lists targets.
.DEFAULT_GOAL := help
SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c
UV := uv run --frozen
APP := {{ package_name }}.entrypoints.http.app:create_app
# Targets always use the project's own .venv (managed by uv), even when another virtualenv is active.
unexport VIRTUAL_ENV
# Import the project from src/ even when Python skips its .pth file: on macOS, folders synced by
# iCloud (Documents, Desktop) can mark .venv files hidden, and Python 3.13+ ignores hidden .pth files.
export PYTHONPATH := $(CURDIR)/src$(if $(PYTHONPATH),:$(PYTHONPATH))
# The `docker compose` plugin, else the standalone `docker-compose` (evaluated once, when used).
COMPOSE = $(eval COMPOSE := $(shell docker compose version >/dev/null 2>&1 && echo "docker compose" \
	|| { command -v docker-compose >/dev/null 2>&1 && echo docker-compose; }))$(COMPOSE)
# Explain what is missing instead of failing inside Docker with a cryptic error.
define check_docker
	@command -v docker >/dev/null || { echo "Docker is not installed (Docker Desktop, Colima or OrbStack).$(1)" >&2; exit 1; }
	@docker info >/dev/null 2>&1 || { echo "Docker is installed but not running: start Docker Desktop, or run colima start --cpu 4 --memory 6.$(1)" >&2; exit 1; }
	@test -n "$(COMPOSE)" || { echo "Docker Compose is missing. With Homebrew (Colima): brew install docker-compose, then add \"cliPluginsExtraDirs\": [\"$$(brew --prefix 2>/dev/null || echo /opt/homebrew)/lib/docker/cli-plugins\"] to ~/.docker/config.json.$(1)" >&2; exit 1; }
endef
{%- if use_postgres or use_redis or event_broker != 'none' %}
# `make dev DOCKER=0` uses services you already run (URLs in .env) instead of compose.
DOCKER ?= 1
INFRA :={% if use_postgres %} postgres{% endif %}{% if use_redis %} redis{% endif %}{% if event_broker != 'none' %} broker{% endif %}
{%- endif %}

.PHONY: help
help: ## List targets
	@if [ -t 1 ]; then on='\033[36m'; off='\033[0m'; else on=; off=; fi; \
	grep -hE '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' -v on="$$on" -v off="$$off" '{printf "  %s%-12s%s %s\n", on, $$1, off, $$2}'

.PHONY: bootstrap
bootstrap: ## Install dependencies into .venv and create .env with a local dev secret
	@test -e .git || git init -q -b main
	uv sync --all-groups
	@if [ "$$(uname)" = Darwin ]; then chflags -R nohidden .venv; fi
	@test -e .env || { cp .env.example .env \
		&& printf '\n# Local dev secret created by make bootstrap\n' >> .env \
		&& echo "APP_AUTH_DEV_SECRET=$$($(UV) python -c 'import secrets; print(secrets.token_hex(32))')" >> .env \
		&& echo "Created .env with local settings and a dev secret for make token (never commit it)."; }

.PHONY: dev
dev: bootstrap{% if use_postgres or use_redis or event_broker != 'none' %} infra{% endif %}{% if use_postgres %} migrate{% endif %} ## Start everything for local development; API with reload on http://127.0.0.1:8000/docs
	$(UV) uvicorn --factory $(APP) --reload
{%- if use_postgres or use_redis or event_broker != 'none' %}

.PHONY: infra
infra: ## Start only the infrastructure in Docker; DOCKER=0 skips it
ifeq ($(DOCKER),1)
	$(call check_docker, Or run your own $(INFRA) and use DOCKER=0 with their URLs in .env.)
	$(COMPOSE) up -d --wait $(INFRA)
else
	@echo "DOCKER=0: using the service URLs in .env ($(INFRA) must already be running)"
endif
{%- endif %}

.PHONY: setup
setup: bootstrap ## Install dependencies and Git hooks
	$(UV) pre-commit install --install-hooks

.PHONY: fmt
fmt: ## Auto-fix formatting and lint
	$(UV) ruff format .
	$(UV) ruff check --fix .

.PHONY: lint
lint: ## Ruff lint + format check (PEP 8 / PEP 257 / bandit)
	$(UV) ruff format --check .
	$(UV) ruff check .

.PHONY: typecheck
typecheck: ## mypy --strict
	$(UV) mypy

.PHONY: arch
arch: ## Enforce hexagonal layering (import-linter)
	$(UV) lint-imports

.PHONY: audit
audit: ## Known-vulnerability scan of the locked dependency tree
	uv lock --check
	uv export --frozen --all-groups --no-emit-project --format requirements-txt -q \
		| $(UV) pip-audit --strict --disable-pip --require-hashes -r /dev/stdin

.PHONY: test-unit
test-unit: ## Fast feedback: unit + API tests, no Docker
	$(UV) pytest -m "not integration"

.PHONY: test
test: ## Full suite incl. integration (Docker) with coverage gate
	$(UV) pytest --cov --cov-report=term --cov-report=xml

.PHONY: check
check: lint typecheck arch audit test ## Everything CI runs: the Definition of Done gate

.PHONY: run
run: ## Run only the API with reload (make dev also prepares .env and infrastructure)
	$(UV) uvicorn --factory $(APP) --reload
{%- if event_broker != 'none' %}

.PHONY: worker
worker: ## Run the event consumer
	$(UV) faststream run --factory {{ package_name }}.entrypoints.worker:create_worker
{%- endif %}
{%- if use_postgres %}

.PHONY: migrate
migrate: ## Apply database migrations
	$(UV) alembic upgrade head

.PHONY: migration
migration: ## New migration: make migration m="add orders table"
	$(UV) alembic revision --autogenerate -m "$(m)"
{%- endif %}

.PHONY: token
token: ## Dev bearer token (secret created by make bootstrap): make token sub=alice scopes="items:read items:write"
	$(UV) python scripts/dev_token.py --sub "$(or $(sub),alice)" --scopes "$(or $(scopes),items:read items:write)"

.PHONY: up
up: ## Run the production image and its infrastructure in Docker (builds the image; slower)
	$(call check_docker)
	$(COMPOSE) up -d --build --wait

.PHONY: down
down: ## Stop everything and drop volumes
	$(call check_docker)
	$(COMPOSE) down -v

.PHONY: image
image: ## Build the container image
	docker build --build-arg APP_VERSION=$$(git rev-parse --short HEAD 2>/dev/null || echo dev) -t {{ project_slug }}:local .

.PHONY: smoke
smoke: ## Verify a deployment: make smoke url=https://... version=<sha>
	$(UV) python scripts/smoke.py --url "$(url)" --version "$(version)"
